# URL do App da Web do Apps Script preso à planilha de leads (termina em /exec).
VITE_LEADS_ENDPOINT=https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec

# Token compartilhado, igual ao TOKEN em scripts/apps-script/Codigo.gs.
# Atenção: como o app é estático, este valor vai para o bundle e é público.
# Ele só filtra ruído de bots — não é uma credencial.
VITE_LEADS_TOKEN=troque-este-valor

# WhatsApp do comercial, só dígitos com DDI e DDD (ex.: 5511999999999).
# Sem este valor os botões de WhatsApp não aparecem.
VITE_WHATSAPP_NUMBER=
